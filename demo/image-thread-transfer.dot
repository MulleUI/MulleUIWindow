digraph scenario {
    // Set overall graph properties
    rankdir=TB;  // Top to Bottom layout
    node [shape=box, style="rounded,filled", fontname="Arial"];
    edge [fontname="Arial"];
    
    // Define subgraphs for each thread/window/context group
    subgraph cluster_0 {
        label="Thread 1 Environment";
        color=lightblue;
        style=filled;
        
        thread1 [label="Thread 1", fillcolor=skyblue];
        window1 [label="Window 1", fillcolor=lightgreen];
        gc1 [label="Graphic Context 1", fillcolor=lightyellow];
        
        thread1 -> window1 [label="manages"];
        thread1 -> gc1 [label="controls"];
        window1 -> gc1 [label="renders with"];
    }
    
    // Image node in the middle
    image [label="Image", shape=note, fillcolor=lightcoral];
    
    subgraph cluster_1 {
        label="Thread 2 Environment";
        color=lavender;
        style=filled;
        
        thread2 [label="Thread 2", fillcolor=skyblue];
        window2 [label="Window 2", fillcolor=lightgreen];
        gc2 [label="Graphic Context 2", fillcolor=lightyellow];
        
        thread2 -> window2 [label="manages"];
        thread2 -> gc2 [label="controls"];
        window2 -> gc2 [label="renders with"];
    }
    
    // Force vertical ordering with invisible edges
    thread1 -> image [style=invis];
    image -> thread2 [style=invis];
    
    // Show the image passing from gc1 to gc2
    gc1 -> image [label="creates"];
    image -> gc2 [label="passed to", style=dashed, color=red, penwidth=2.0];
    
    // Add thread/autorelease relationships
    thread1 -> image [label="thread/autorelease", style=dotted, color=gray, penwidth=1.0, constraint=false];
    thread2 -> image [label="thread/autorelease", style=solid, color=black, penwidth=1.5, constraint=false];
    
    // Add resource relationships
    gc1 -> image [label="resource", style=dotted, color=gray, penwidth=1.0, constraint=false];
    gc2 -> image [label="resource", style=solid, color=black, penwidth=1.5, constraint=false];
}
